{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",

        ".write": "auth != null && auth.uid === $uid && newData.exists()",

        "role": {
          ".write": false
        }
      }
    },

    "projects": {
      "$projectId": {
        ".read": "auth != null",

        ".write": "auth != null && (newData.child('owner').val() === auth.uid || auth.token.admin === true)",

        "title": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "owner": {
          ".validate": "newData.val() === auth.uid"
        },
      "members": {
  ".validate": "newData.hasChildren() || !newData.exists()"
}

      }
    }
  }
}
